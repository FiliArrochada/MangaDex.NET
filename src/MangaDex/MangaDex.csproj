<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<GenerateAssemblyInfo>true</GenerateAssemblyInfo>
		<!-- emits AssemblyVersion/FileVersion from <Version> (fixes Sonar S3904); the old project-system#3934 bug no longer applies on modern SDKs -->
		<TargetFrameworks>net10.0;net48</TargetFrameworks>
		<!-- net48 defaults to C# 7.3; the source is kept compatible, but pin explicitly -->
		<LangVersion>latest</LangVersion>
		<AssemblyName>MangaDex</AssemblyName>
		<PackageId>MangaDex</PackageId>
		<OutputType>Library</OutputType>
		<Authors>FiliArrochada</Authors>
		<Company>FiliArrochada</Company>
		<AssemblyTitle>MangaDex API Client</AssemblyTitle>
		<Description>A .NET client library for the MangaDex API.</Description>
		<Copyright>Copyright (c) 2026 FiliArrochada</Copyright>
		<RootNamespace>MangaDex</RootNamespace>
		<!-- Version tracks the MangaDex API version (Major.Minor.Patch); 
		 the 4th revision component is bumped for client-only fixes against the same API version (e.g. 5.13.1.1). -->
		<Version>5.13.1.3</Version>
		<DocumentationFile>bin\$(Configuration)\$(TargetFramework)\MangaDex.xml</DocumentationFile>
		<!-- CS1591: undocumented members (generated Refit interfaces); CS8073: value-type != null in generated Equals;
         RF006: deepObject dictionary params fall back to the reflection request builder — expected,
         we ship Refit.Reflection for exactly this (see the PackageReference note below) -->
		<NoWarn>$(NoWarn);CS1591;CS8073;RF006</NoWarn>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageProjectUrl>https://github.com/FiliArrochada/MangaDex.NET</PackageProjectUrl>
		<RepositoryUrl>https://github.com/FiliArrochada/MangaDex.NET.git</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageReleaseNotes>Multi-targets net10.0 and net48. Same MangaDex API surface (5.13.1).</PackageReleaseNotes>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="System.Text.Json" />
		<PackageReference Include="Refit" />
		<!-- Refit 14+ ships the reflection request builder as a separate package. The deepObject
         dictionary params (IMangaApi.GetSearchManga, IChapterApi.GetChapter) cannot be
         source-generated, so RestService.For<T> needs this at runtime (verified still required
         on Refit 15 — removing it fails the Refit slice tests with NotSupportedException).
         Referenced here so the dependency flows to consumers. Keep version-locked to Refit. -->
		<PackageReference Include="Refit.Reflection" />
		<PackageReference Include="System.ComponentModel.Annotations" />
	</ItemGroup>

	<ItemGroup>
		<!-- Ship the repo README as the package readme (referenced by PackageReadmeFile above).
         Path is relative to this project (repo root is two levels up). -->
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>
</Project>